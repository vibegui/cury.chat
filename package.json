{
	"name": "cury-mcp",
	"version": "0.1.0",
	"description": "cury.chat — projeto independente. Worker Cloudflare com bot de WhatsApp ancorado em materiais públicos de Augusto Cury. Webhook → AutoRAG → LLM (OpenRouter via CF AI Gateway) → WhatsApp send.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"dev:web": "vite build --watch",
		"build:web": "vite build",
		"build:chat": "vite build --config vite.chat.config.ts",
		"build": "bun run build:web && bun run build:chat",
		"deploy": "wrangler deploy",
		"deploy:landing": "wrangler pages deploy landing --project-name=cury-chat",
		"check": "tsc --noEmit",
		"test": "bun test",
		"fmt": "biome format --write .",
		"lint": "biome lint --write .",
		"brand": "bun run scripts/generate-brand.ts",
		"fetch-corpus": "bun run scripts/fetch-corpus.ts",
		"upload-corpus": "bun run scripts/upload-corpus.ts",
		"seed-prompt": "bun run scripts/seed-prompt.ts",
		"configure-webhook": "bun run scripts/configure-webhook.ts",
		"tyxter:setup": "bun run scripts/tyxter-setup.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/ext-apps": "^1.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.6.0",
		"lucide-react": "^0.576.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@cloudflare/workers-types": "^4.20250109.0",
		"@tailwindcss/vite": "^4.2.1",
		"@types/bun": "^1.3.8",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.0.4",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-singlefile": "^2.3.0",
		"wrangler": "^4.129.0"
	}
}
